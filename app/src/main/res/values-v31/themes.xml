<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ launch splash. The launcher icon is a plain vector (crisp
         on the Kompakt home screen, like the stock Mudita icons), and the
         system draws non-adaptive icons small on the splash. This adaptive
         copy lays the same artwork out like Calm Chevy's adaptive icon (the
         icon filling the 72dp viewport of the 108dp layer), so the splash
         shows it at the same size as Chevy's. -->
    <style name="Theme.Calm" parent="Base.Theme.Calm">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
    </style>
</resources>
