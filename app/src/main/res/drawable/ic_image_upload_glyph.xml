<!-- Scanner toolbar: switch to Image Upload. A photo (frame, mountains, sun)
     with an upload arrow rising from its open corner. Drawn white on the
     black 32dp square (ScannerScreen.BlackSquareIcon), like the Home screen's
     "+"; the group scales the picture to fill the 24-unit viewport, which
     BlackSquareIcon then draws at 30dp (SQUARE_GLYPH_SIZE). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:pivotX="12.625"
        android:pivotY="11.25"
        android:scaleX="1.3"
        android:scaleY="1.3"
        android:translateX="-0.625"
        android:translateY="0.75">
        <!-- Photo frame, open at the top-right corner for the arrow -->
        <path
            android:pathData="M13,8H7.75A1.25,1.25 0,0 0,6.5 9.25V15.5A1.25,1.25 0,0 0,7.75 16.75H14.25A1.25,1.25 0,0 0,15.5 15.5V12.5"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Mountains -->
        <path
            android:pathData="M7.9,15.1L10.25,12.6L12.2,14.55L13.2,13.55L14.2,14.55"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Sun -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M9.35,10.6m-0.95,0a0.95,0.95 0 1,1 1.9,0a0.95,0.95 0 1,1 -1.9,0" />
        <!-- Upload arrow -->
        <path
            android:pathData="M17,11V5.75M15.25,7.5L17,5.75L18.75,7.5"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
