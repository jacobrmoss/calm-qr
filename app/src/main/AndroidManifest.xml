<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Image Upload: browse the photo gallery from the Scanner screen. With
         targetSdk <= 32 this is the permission on every Android version; a
         targetSdk 33+ bump would need READ_MEDIA_IMAGES instead. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <application
        android:name=".CalmQrApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_mmd"
        android:roundIcon="@drawable/ic_launcher_mmd"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Calm">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Calm">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
